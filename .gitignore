# Dependencies are installed with npm install, never committed.
node_modules/

# Scratch output from AI coding tools and one-off data cleaning. It can hold
# cell-by-cell dumps of the source workbooks, so it must never be committed.
.codex-tmp/
outputs/

# Firebase CLI and local emulators
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.firebaserc

# Local function configuration and credentials
firebase/functions/.env
firebase/functions/.env.*
!firebase/functions/.env.example
*service-account*.json

# Raw source workbooks contain personal data (passport, ACR, birth dates, addresses).
# Only counts are published (to Firestore); the generated summary is rebuilt from the workbook.
*.xlsx
*.xls
firebase/foreign-students/foreign-students.json
firebase/reports/*.json
__pycache__/

